# Copy these into your host's Environment Variables (Vercel/Netlify Settings),
# or a local .env file. Every key is FREE. Apple needs no key at all.

# ============================================================
#  SCOPE TO YOUR SHOW  (recommended — prevents wrong matches)
#  With these set, searching a guest name only matches episodes
#  of Global Book Network instead of the whole internet.
# ============================================================

# Your YouTube channel ID — starts with "UC".
# Find it: YouTube Studio → Settings → Channel → Advanced settings.
YOUTUBE_CHANNEL_ID=

# Your Apple Podcasts show ID — the number after "/id" in your show URL.
# e.g. podcasts.apple.com/us/podcast/global-book-network/id1234567890 → 1234567890
APPLE_PODCAST_ID=

# Your Spotify show ID — the code in open.spotify.com/show/<THIS_PART>
SPOTIFY_SHOW_ID=

# ============================================================
#  API KEYS
# ============================================================

# --- YouTube (free) ---
# https://console.cloud.google.com → create project →
# enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# --- Spotify (free) ---
# https://developer.spotify.com/dashboard → Create app → copy Client ID & Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Apple Podcasts ---
# No key required.
