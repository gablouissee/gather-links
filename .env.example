# Copy the values you have into your host's Environment Variables (Vercel/Netlify),
# or into a local .env file. Every key is FREE. Apple needs no key at all.

# --- YouTube (free) ---
# Get one at https://console.cloud.google.com → create project →
# enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=
# Optional: restrict search to your own channel (find it in your channel URL / studio).
YOUTUBE_CHANNEL_ID=

# --- Spotify (free) ---
# Create an app at https://developer.spotify.com/dashboard → copy Client ID & Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
