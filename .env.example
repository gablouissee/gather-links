# Copy these into your host's Environment Variables (Vercel/Netlify Settings),
# or a local .env file.

# ============================================================
#  API KEYS — all optional. Apple and YouTube need none.
# ============================================================

# --- YouTube (OPTIONAL) ---
# Not needed: YouTube resolves from the channel's public feed with no key.
# A key only extends reach past the latest 15 uploads, for older episodes.
# https://console.cloud.google.com → create a project →
# enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# --- Spotify (NOT free: needs a paid Spotify Premium account) ---
# Spotify blocks Web API access for free accounts. Leave these empty unless you
# have Premium; Spotify then stays a manual paste field, which is fine.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Apple Podcasts ---
# No key required. Works as soon as you deploy.

# ============================================================
#  SHOW IDS — already set to Global Book Network in the code.
#  Only set these to point the generator at a DIFFERENT show.
# ============================================================

# Default: UC1fzWsm6INY4aYEIYPGMIBw  (youtube.com/@GlobalBookNetwork)
# YOUTUBE_CHANNEL_ID=

# Default: 1789422185  (podcasts.apple.com/us/podcast/global-book-network/id1789422185)
# APPLE_PODCAST_ID=

# Default: 0jsYkdCqjGzmxK8JkceRa3  (open.spotify.com/show/0jsYkdCqjGzmxK8JkceRa3)
# SPOTIFY_SHOW_ID=
